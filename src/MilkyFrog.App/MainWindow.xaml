<Window
    x:Class="MilkyFrog.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="奶蛙"
    Width="210"
    Height="260"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem
                Header="隐藏奶蛙"
                Click="HideMenuItem_Click"/>

            <Separator/>

            <MenuItem
                Header="退出"
                Click="ExitMenuItem_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid
        Margin="8"
        Background="Transparent"
        PreviewMouseLeftButtonDown="PetSurface_MouseLeftButtonDown"
        PreviewMouseMove="PetSurface_MouseMove"
        PreviewMouseLeftButtonUp="PetSurface_MouseLeftButtonUp">

        <Grid x:Name="PlaceholderCharacter">
            <Ellipse
                Width="135"
                Height="25"
                Margin="0,0,0,4"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Fill="#28000000"/>

            <Border
                Width="165"
                Height="225"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#FFFFC928"
                BorderBrush="#FFD99B00"
                BorderThickness="2"
                CornerRadius="78">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="76"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        Margin="24,18,24,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Ellipse
                            x:Name="LeftEye"
                            Grid.Column="0"
                            Width="44"
                            Height="44"
                            HorizontalAlignment="Left"
                            Fill="#FFF8F4DA"
                            Stroke="#FF876C1D"
                            StrokeThickness="2"/>

                        <Ellipse
                            x:Name="RightEye"
                            Grid.Column="1"
                            Width="44"
                            Height="44"
                            HorizontalAlignment="Right"
                            Fill="#FFF8F4DA"
                            Stroke="#FF876C1D"
                            StrokeThickness="2"/>

                        <Ellipse
                            Grid.Column="0"
                            Width="17"
                            Height="17"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="#FF303020"
                            IsHitTestVisible="False">

                            <Ellipse.RenderTransform>
                                <TranslateTransform
                                    x:Name="LeftPupilTransform"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <Ellipse
                            Grid.Column="1"
                            Width="17"
                            Height="17"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="#FF303020"
                            IsHitTestVisible="False">

                            <Ellipse.RenderTransform>
                                <TranslateTransform
                                    x:Name="RightPupilTransform"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>

                    <Ellipse
                        Grid.Row="1"
                        Width="125"
                        Height="125"
                        Margin="0,10,0,16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Fill="#FFFFE2A0"/>

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,0,0,28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#FF624000"
                        Text="奶蛙"/>
                </Grid>
            </Border>
        </Grid>

        <Image
            x:Name="CharacterAnimationImage"
            Panel.ZIndex="10"
            RenderOptions.BitmapScalingMode="NearestNeighbor"
            Stretch="Uniform"
            IsHitTestVisible="False"/>
    </Grid>
</Window>
